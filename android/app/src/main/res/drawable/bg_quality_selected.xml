<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="0" android:startColor="@color/violet"
                android:centerColor="@color/pink" android:endColor="@color/amber" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape>
            <solid android:color="#1E1433" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
