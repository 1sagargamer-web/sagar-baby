# Raw footage and finished videos are large; keep them out of git
Raw/*
!Raw/.gitkeep
Export/*
!Export/.gitkeep
!Export/test.mp4

# Reference video copies (notes like my-style.md are kept)
Reference/*.mp4
Reference/*.mov

# HyperFrames working data
.hyperframes/
node_modules/
models/

# Copy of the skills made by the installer for a different agent (Claude uses .agents/skills)
agent/

# Generated voice files (rebuilt by make_reel.py)
projects/*/assets/audio/
Reference/*.transcript.json
__pycache__/
.venv-tts/
